# ==============================================================================
# Praxora Standalone Admin Dashboard - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# Note: Never commit production credentials or sensitive keys to source control.
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0

# Runtime Environment (development | production | test)
NODE_ENV=development

# JWT Authentication Secret (Must be 32+ characters in production)
JWT_SECRET=development-praxora-jwt-secret-min-32-chars-replace-in-production

# SQLite Database File Path (Relative to backend or absolute)
DB_PATH=server/operations.db

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173

# Frontend API Base URL (Used by Vite client)
# For local dev with Vite proxy, use: /api
# For direct backend connection or future integration, use: http://localhost:5000/api
# When integrating with the future main website backend, point this to the shared API gateway
VITE_API_BASE_URL=/api
