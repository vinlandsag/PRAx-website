# ==============================================================================
# PRAX Platform — Environment Variables Example
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local to Git.
# ==============================================================================

# Session & Authentication Secret (at least 32 characters)
SESSION_SECRET=prax-dev-session-secret-change-in-production-32-chars

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Database & Auth)
# Find these in your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon Key (public browser key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SECRET: server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Postgres Connection URI (from Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
