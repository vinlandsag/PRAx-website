# ==============================================================================
# PRAX Platform — Environment Variables Example
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local to Git.
# ==============================================================================

# Session & Authentication Secret (at least 32 characters)
SESSION_SECRET=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL connections (Prisma runtime and migrations)
# Find these in Supabase Dashboard -> Project Settings -> Database.
# Use the pooled URL for runtime and a direct/session URL for Prisma migrations.
# ------------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=
